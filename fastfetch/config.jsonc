{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "height": 6,
    "width": 3,
    "padding": {
      "right": 5,
      "left": 0,
      "top": 0,
      "bottom": 0
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "            "
    },
    "break",
    {
      "type": "os",
      "key": " ",
     },
    {
      "type": "kernel",
      "key": " ",
    },
    {
      "type": "shell",
      "key": " ",
    },
    {
      "type": "wm",
      "key": " ",
    },
     {
      "type": "packages",
      "key": " ",
    },
    {
      "type": "uptime",
      "key": " ",
    },
    {
      "type": "cpu",
      "key": "󰻠 ",
    },
    {
      "type": "gpu",
      "key": " ",
    },
    "break",
    {
      "type": "custom",
      "format": "              "
    },
    "break",
    "break"
  ]
}
